# FindNord environment variables.
# Copy this file to .env.local (or export these in your real deploy
# environment) and fill in what you need. Every one of these has a safe
# fallback or a clear runtime error if left unset -- nothing crashes
# silently -- see DEPLOYMENT_READINESS_PLAN.md for the full audit this file
# was written from.
#
# This app reads process.env directly; it doesn't load a .env file itself
# (no dotenv dependency). Use your shell, your process manager, or your
# hosting platform's own env-var config to set these for a real run.

# --- Core server ---

# Port the Express server listens on. Defaults to 4173.
PORT=4173

# Set this to "production" in your real deploy. Controls: whether the
# session cookie sets the Secure flag (needs HTTPS in front -- see the
# reverse-proxy note below), and whether seedIfEmpty() seeds fake demo
# listings into a genuinely empty database (it does NOT when NODE_ENV is
# "production", unless SEED_DEMO_DATA=true below explicitly opts back in).
# Leave unset for local dev/test -- everything defaults to the permissive
# dev-friendly behavior.
NODE_ENV=production

# Where persistent application data lives. Both paths default to directories
# inside the project for local development. On Railway, create one persistent
# volume in the dashboard, mount it at /app/storage, and set both variables as
# shown below. Railway's service filesystem outside that mount is ephemeral.
# DB_PATH=/app/storage/findnord.db
# UPLOADS_DIR=/app/storage/uploads

# Only relevant if NODE_ENV=production: set to "true" to seed the fake demo
# listings from db/seed-data.js anyway (e.g. a staging environment that
# wants sample data). Leave unset for a real production launch.
# SEED_DEMO_DATA=true

# --- Admin ---

# The one email address treated as the site admin. Synced to the real
# is_admin DB column only at sign-in (see scripts/auth.js's syncAdminFlag) --
# changing this later doesn't retroactively promote/demote anyone already
# signed in. Leave unset to have no admin account at all.
# ADMIN_EMAIL=you@example.com

# --- Google Sign-In ---

# The real Google OAuth Client ID (Google Identity Services / ID-token flow).
# "Continue with Google" shows as unavailable, gracefully, until this is set.
# GOOGLE_CLIENT_SECRET is NOT needed by this app at all -- the ID-token flow
# this uses doesn't require it (see scripts/google-auth.js).
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- AI photo generation (OpenAI) ---

# Real OpenAI API key, used server-side only (never reaches the browser) to
# generate a placeholder listing photo. Without it, the feature returns a
# clear error instead of crashing. Real financial exposure once set -- this
# route is rate-limited to 10 generations/account/day (see scripts/server.js)
# specifically to cap that.
# OPENAI_API_KEY=sk-...

# Which OpenAI image model to call. Defaults to "gpt-image-1".
# OPENAI_IMAGE_MODEL=gpt-image-1

# --- Boost / Premium payments (Stripe) ---

# Master switch for real Stripe payments on Boost. When set explicitly, it
# always wins -- exactly "true" enables paid boosts immediately, anything else
# keeps them free, on that deployment alone.
#
# When left UNSET, the free launch window decides instead: boosting is free
# and paid checkout stays blocked until BOOST_FREE_UNTIL passes, then payments
# open on their own with no code change and no manual flag-flip. The Stripe
# integration code is real (Checkout Sessions + webhook signature verification
# via fetch, no stripe SDK) but has never been exercised against a live Stripe
# account in this project -- run one real end-to-end test in Stripe's own test
# mode before relying on it for real, see DEPLOYMENT_READINESS_PLAN.md Phase 2.
# BOOST_PAYMENTS_ENABLED=true

# When the free boost window closes. ISO date (YYYY-MM-DD), UTC midnight.
# Leave unset: the server then anchors it to its OWN first-ever start plus
# 6 months and persists that in the database, so restarts, redeployments and
# scaling never move the deadline. Set it explicitly to shorten the promotion
# (or put it in the past to open paid boosts right now). An unparseable value
# is ignored and the stored date is used instead -- a typo can never enable
# payments early.
# BOOST_FREE_UNTIL=2027-04-17

# Required if BOOST_PAYMENTS_ENABLED=true. Without it, checkout fails
# cleanly with a clear STRIPE_NOT_CONFIGURED error rather than crashing.
# STRIPE_SECRET_KEY=sk_test_...

# Required if BOOST_PAYMENTS_ENABLED=true, to verify Stripe's webhook
# signature. Without it, the webhook route returns a clean 503.
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Transactional email (AWS SES) ---
#
# Phase 2: real AWS SES integration for password-reset emails.
# When all four are set, password-reset emails are sent via SES.
# When any are missing, falls back to console.log (dev/test behavior) so
# existing workflows (tests reading the reset link from stdout) keep working.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# SES_FROM_EMAIL=noreply@yourdomain.com  # Must be a verified sender in SES

# --- Error tracking (Sentry) ---
#
# Phase 2: Sentry DSN for real error tracking in production.
# Without it, Sentry initializes silently and captures nothing -- no behavior
# change in dev/test. Set this in your real deploy to enable.
# SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0

# --- Local mobile-visual-QA harness only (scripts/mobile-visual-qa.js) ---
# Not used by the real app/server -- only by the manual screenshot QA script.

# Origin the QA script points its real headless Chrome instance at. Defaults
# to http://127.0.0.1:4173.
# FINDNORD_QA_ORIGIN=http://127.0.0.1:4173

# Path to a local Chrome/Chromium binary. Defaults to the standard Windows
# install path.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
